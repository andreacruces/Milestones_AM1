def F_linear(U, t):
    return -U

x0_lin = 1.0 
U0_lin = array([x0_lin]) 

def Leap_Frog(U1, t1, t2, F):
    
    dt = t2 - t1
    x, v = U1
    
    v_half = v + 0.5 * dt * (-x) 
    
    x_new = x + dt * v_half
    
    v_new = v_half + 0.5 * dt * (-x_new)
    
    return array([x_new, v_new])

def F_oscillator(y, t):
    
    return array([y[1], -y[0]])

def simular(metodo, y0, h, T):
    N = int(T/h)
    t = linspace(0, T, N + 1) 
    y = zeros((N + 1, len(y0)))
    y[0] = y0

    for n in range(N):
        y[n+1] = metodo(y[n], t[n], t[n+1], F_oscillator)

    return t, y

def R_Euler(w):
    return 1 + w

def R_RK4(w):
    return 1 + w + w**2/2 + w**3/6 + w**4/24

def R_CN(w):
    return (1 + w/2) / (1 - w/2)

def R_EI(w):
    return 1 / (1 - w)

def R_LF_System(w):
    
    dt_norm = abs(w) 
    return ones_like(w) * max(abs(array([1 - 0.5*w**2 + w*sqrt(1 - 0.25*w**2)])))

def region_estabilidad(func, N=400, x0=-3, xf=3, y0=-3, yf=3):
 
    X = linspace(x0, xf, N)
    Y = linspace(y0, yf, N)
    W = X + 1j*Y[:, None] 

    R = func(W)
    return abs(R) <= 1

