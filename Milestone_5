from numpy import array, reshape, zeros, linspace, pi, cos, sin
from numpy.linalg import norm
import matplotlib.pyplot as plt
from Milestone_3 import Cauchy
from Milestone_3 import RK4
from mpl_toolkits.mplot3d import Axes3D  

def Initial_conditions(Nb, Nc):
   
    U0 = zeros(2 * Nc * Nb) 
    U1 = reshape(U0, (Nb, Nc, 2)) 
    r0 = reshape(U1[:, :, 0], (Nb, Nc))
    v0 = reshape(U1[:, :, 1], (Nb, Nc))

    radius = 1.5  
    angular_velocity = 0.3 

    
    for i in range(Nb):
        angle = 2 * pi * i / Nb  
        r0[i, :] = [radius * cos(angle), radius * sin(angle), 0]
        v0[i, :] = [-radius * sin(angle) * angular_velocity, 
                     radius * cos(angle) * angular_velocity, 0]

    return U0 


def N_Body_Problem(U, t, Nb, Nc):
  
    pu = reshape(U, (Nb, Nc, 2))  
    r = reshape(pu[:, :, 0], (Nb, Nc))  
    v = reshape(pu[:, :, 1], (Nb, Nc))  
    
    Fs = zeros(len(U))
    pFs = reshape(Fs, (Nb, Nc, 2)) 
    
    drdt = reshape(pFs[:, :, 0], (Nb, Nc))  
    dvdt = reshape(pFs[:, :, 1], (Nb, Nc))  
    
    dvdt[:, :] = 0  
    
    for i in range(Nb):  
        drdt[i, :] = v[i, :]  
        for j in range(Nb):
            if j != i:  
                d = r[j, :] - r[i, :]
                dvdt[i, :] = dvdt[i, :] + d[:] / norm(d) ** 3
    return Fs


def F_N_Body_Problem(U, t): 
   
    return N_Body_Problem(U, t, Nb, Nc)


N = 1000  
Nb = 6    
Nc = 3    


t0 = 0
tf = 4 * pi
t = linspace(t0, tf, N+1)  


U0 = Initial_conditions(Nb, Nc)

U = Cauchy(RK4, U0, F_N_Body_Problem, t)


Us = reshape(U, (N+1, Nb, Nc, 2)) 
r = reshape(Us[:, :, :, 0], (N+1, Nb, Nc)) 


plt.figure(figsize=(8, 6))
for i in range(Nb):
    plt.plot(r[:, i, 0], r[:, i, 1], label=f'Cuerpo {i+1}')
plt.axis('equal')
plt.grid(True)
plt.title('Trayectorias de los Cuerpos en el Plano XY')
plt.xlabel('X [m]')
plt.ylabel('Y [m]')
plt.legend()
plt.show()

fig = plt.figure(figsize=(10, 8))
ax = fig.add_subplot(111, projection='3d')

for i in range(Nb):
    ax.plot3D(r[:, i, 0], r[:, i, 1], r[:, i, 2], label=f'Cuerpo {i+1}')

ax.set_xlabel('X [m]')
ax.set_ylabel('Y [m]')
ax.set_zlabel('Z [m]')
ax.legend()
plt.show()
