from numpy import array, zeros, linspace, concatenate, float64
import matplotlib.pyplot as plt
from scipy.optimize import newton

x0=1 #posición inicial en x
y0=0 #posición inicial en y
vx0=0 #velocidad inicial en x
vy0=1 #velocidad inicial en y

U0=array([x0,y0,vx0,vy0])
print(U0)

T = 400
N = 10000
delta_t = T / N

def F(U, t):
    x = U[0]; y = U[1]; dxdt = U[2]; dydt = U[3]
    d = ( x**2  +y**2 )**1.5

    return  array( [ dxdt, dydt, -x/d, -y/d ] ) 

def Cauchy(temporal_scheme, U0, F, t):
    N = len(t) - 1
    Nv= len(U0)
    U = zeros( (N+1, Nv), dtype=float64 ) 
    U[0,:] = U0
    for n in range(N): 
        U[n+1,:] = temporal_scheme( U[n, :], t[n+1] - t[n], t[n],  F ) 
    return U


def Euler(U_n, dt, t_n, F):
    return U_n + dt * F(U_n, t_n) # Milestone 2.1

def RK4(U_n, dt, t_n, F):
    k1 = F(U_n, t_n)
    k2 = F(U_n + 0.5 * k1 * dt, t_n + 0.5 * dt)
    k3 = F(U_n + 0.5 * k2 * dt, t_n + 0.5 * dt)
    k4 = F(U_n + k3 * dt, t_n + dt)
    return U_n + (1.0 / 6.0) * dt * (k1 + 2 * k2 + 2 * k3 + k4) # Milestone 2.3

def Crank_Nicolson(U_n, dt, t_n, F): 
    def G(X): # Siendo X = U(n-1)
        return X - U_n - dt/2 * (F(X, t_n) + F(U_n, t_n))
    return newton(G, U_n)

def Inverse_Euler(U_n, dt, t_n, F):
    def G(X):
        return X - U_n - dt * F(X, t_n + dt)
    return newton(G, U_n) # Milestone 2.4

t = linspace(0, T, N + 1)

U_Euler = Cauchy (Euler, U0, F, t)
plt.plot(U_Euler[:,0], U_Euler[:,1])
plt.show()

U_RK4 = Cauchy (RK4, U0, F, t)
plt.plot(U_RK4[:,0], U_RK4[:,1])
plt.show()


U_CN = Cauchy (Crank_Nicolson, U0, F, t)
plt.plot(U_CN[:,0], U_CN[:,1])
plt.show()


U_EulerInverso = Cauchy (Inverse_Euler, U0, F, t)
plt.plot(U_EulerInverso[:,0], U_EulerInverso[:,1])
plt.show()

plt.figure(figsize=(10, 6))
plt.plot(U_Euler[:, 0], U_Euler[:, 1], label="Euler Explícito", alpha=0.6)
plt.plot(U_RK4[:, 0], U_RK4[:, 1], label="Runge-Kutta 4 etapas", alpha=0.6)
plt.plot(U_CN[:, 0], U_CN[:, 1], label="Crank-Nickolson", alpha=0.6)
plt.plot(U_EulerInverso[:,0], U_EulerInverso[:,1], label="Euler Inverso", alpha=0.6)
plt.legend()
plt.xlabel("x")
plt.ylabel("y")
plt.title("Solución de la EDO usando diferentes métodos numéricos")
plt.grid()
plt.show()
