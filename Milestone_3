def Error_Cauchy(temporal_scheme, U0, F, T_final, N_steps):

    global N, t_global 
    
    # 1. Guarda el estado actual
    N_old = N
    t_global_old = t_global
    
    # 2. Redefine las variables globales
    N = N_steps
    t_global = linspace(0, T_final, N + 1)
    
    # 3. Llama a la función de integración original
    U = Cauchy(temporal_scheme, U0, F, t_global)
    
    # 4. Restaura el estado original
    N = N_old
    t_global = t_global_old
    
    return U
def Richardson_Error(temporal_scheme, U0, F, T, N_base, order_p):

    # Solución con paso h (N_base)
    U_h = Error_Cauchy(temporal_scheme, U0, F, T, N_base)
    
    # Solución con paso h/2 (2*N_base)
    U_2h = Error_Cauchy(temporal_scheme, U0, F, T, 2 * N_base)
    
    # Diferencia en el último punto temporal T
    difference_at_T = U_2h[-1, :] - U_h[-1, :]
    
    # Error estimado en U_2N: E = ||U_2N - U_N|| / (2^p - 1)
    error_estimate = norm(difference_at_T) / (2**order_p - 1)
    
    return error_estimate

def convergence(errors, dts):
    p = zeros(len(errors) - 1)
    # Tasa p = log(E_i / E_{i+1}) / log(dt_i / dt_{i+1})
    for i in range(len(errors) - 1):
        p[i] = log(errors[i] / errors[i + 1]) / log(dts[i] / dts[i + 1])
    return p

